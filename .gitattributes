# Preserve native Altium document bytes across checkout platforms.
*.PcbDoc binary
*.SchDoc binary
*.PrjPcb -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
*.PrjPcbStructure -text
# Embedded STEP verification compares exact bytes with these source files.
*.step -text
*.stp -text
